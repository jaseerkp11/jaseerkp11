# Database (SQLite for local/dev). For Vercel production persistence use Neon/Turso Postgres and change prisma/schema.prisma provider to postgresql.
DATABASE_URL="file:./dev.db"

# Signed session cookies. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"

# Public site origin used for canonical URLs, sitemap, OG, redirects, and callbacks.
# Examples: http://localhost:3000  https://your-project.vercel.app  https://yourdomain.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Brand — change these instead of editing components
NEXT_PUBLIC_BRAND_NAME="Atria"
NEXT_PUBLIC_BRAND_TAGLINE="Thoughtful everyday goods for modern Indian homes"
NEXT_PUBLIC_LEGAL_NAME="Atria Retail Private Limited"
NEXT_PUBLIC_LOGO_TEXT="Atria"
NEXT_PUBLIC_LOGO_URL=
NEXT_PUBLIC_FAVICON_URL="/favicon.ico"
NEXT_PUBLIC_PRIMARY_COLOR="#1f3d34"
NEXT_PUBLIC_SECONDARY_COLOR="#c4a574"
NEXT_PUBLIC_ACCENT_COLOR="#b4553a"
NEXT_PUBLIC_BG_COLOR="#f6f1ea"
NEXT_PUBLIC_INK_COLOR="#161513"
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_COUNTRY="IN"
NEXT_PUBLIC_SUPPORT_EMAIL="hello@example.com"
NEXT_PUBLIC_SUPPORT_PHONE="+91 98765 43210"
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_TWITTER=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_WHATSAPP=

# Seeded super-admin (local/demo only)
ADMIN_EMAIL="admin@local.test"
ADMIN_PASSWORD="ChangeMe_admin_123"
SEED_DEMO="true"

# Optional Razorpay (server only). Leave empty to keep UPI/cards disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional email. Leave empty — password reset and newsletter will not pretend to send.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
