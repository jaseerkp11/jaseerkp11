//@version=6
indicator("XAUUSD Liquidity Zones", overlay = true, max_boxes_count = 500, max_lines_count = 500)

// Visual map of gold round-number magnets and swing liquidity.
// This is a chart indicator, not an auto-trading bot.
// Use with the Python scanner (scan.py) for a scored 1-week power ranking.

bool step5     = input.bool(true, "Show $5 levels (prices ending 0 or 5)")
bool step10    = input.bool(true, "Highlight $10 levels")
bool step50    = input.bool(true, "Highlight $50 / $100 magnets")
int swingLen   = input.int(3, "Swing fractal length", minval = 2, maxval = 10)
float eqTol    = input.float(0.6, "Equal high/low tolerance ($)", minval = 0.1)

f_round(float px, float step) =>
    math.round(px / step) * step

float lo = ta.lowest(low, 96)
float hi = ta.highest(high, 96)

var array<line> roundLines = array.new<line>()

if barstate.islast
    while array.size(roundLines) > 0
        line.delete(array.shift(roundLines))
    float startP = f_round(lo, 5.0) - 10.0
    float endP = f_round(hi, 5.0) + 10.0
    float p = startP
    for i = 0 to 80
        if p > endP
            break
        int lvl = int(math.round(p))
        color col = color.new(color.gray, 80)
        int w = 1
        if step50 and (lvl % 100 == 0)
            col := color.new(color.orange, 40)
            w := 3
        else if step50 and (lvl % 50 == 0)
            col := color.new(color.orange, 55)
            w := 2
        else if step10 and (lvl % 10 == 0)
            col := color.new(color.teal, 65)
            w := 2
        else if step5
            col := color.new(color.gray, 78)
            w := 1
        array.push(roundLines, line.new(bar_index - 200, p, bar_index + 10, p, color = col, width = w))
        p += 5.0

float pivotH = ta.pivothigh(high, swingLen, swingLen)
float pivotL = ta.pivotlow(low, swingLen, swingLen)

var float lastH1 = float(na)
var float lastH2 = float(na)
var float lastL1 = float(na)
var float lastL2 = float(na)

if not na(pivotH)
    lastH2 := lastH1
    lastH1 := pivotH
    if not na(lastH2) and math.abs(lastH1 - lastH2) <= eqTol
        box.new(bar_index - swingLen - 30, math.max(lastH1, lastH2) + 0.4, bar_index + 5, math.min(lastH1, lastH2) - 0.15, bgcolor = color.new(color.red, 85), border_color = color.new(color.red, 50))

if not na(pivotL)
    lastL2 := lastL1
    lastL1 := pivotL
    if not na(lastL2) and math.abs(lastL1 - lastL2) <= eqTol
        box.new(bar_index - swingLen - 30, math.max(lastL1, lastL2) + 0.15, bar_index + 5, math.min(lastL1, lastL2) - 0.4, bgcolor = color.new(color.green, 85), border_color = color.new(color.green, 50))

bool sweptHigh = not na(lastH1) and high > lastH1 and close < lastH1
bool sweptLow = not na(lastL1) and low < lastL1 and close > lastL1
plotshape(sweptHigh, title = "Sell-side sweep", style = shape.triangledown, location = location.abovebar, color = color.red, size = size.tiny)
plotshape(sweptLow, title = "Buy-side sweep", style = shape.triangleup, location = location.belowbar, color = color.lime, size = size.tiny)

float atrVal = ta.atr(14)
bool dispUp = sweptLow and (close - open) > 0.5 * atrVal
bool dispDn = sweptHigh and (open - close) > 0.5 * atrVal
color bg = color(na)
if dispUp
    bg := color.new(color.green, 92)
else if dispDn
    bg := color.new(color.red, 92)
bgcolor(bg)
